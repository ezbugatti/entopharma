# entopharma.mn — environment хувьсагчид
# Хуулж аваад `.env.local` нэрээр хадгална. `.env.local` git-д орохгүй.

# --- Sanity ---
# ento.mn-тэй ИЖИЛ project ашиглана. Салбаруудыг `type->value == "pharmacy"`-ээр шүүж татна.
# Хоосон орхивол lib/branches.fallback.ts доторх статик өгөгдлийг ашиглана.
NEXT_PUBLIC_SANITY_PROJECT_ID=wegb2e3b
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-05-30

# --- Холбоо барих формын имэйл (/api/contact) ---
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_RECEIVER=info@entopharma.mn

# --- Сайтын үндсэн URL ---
NEXT_PUBLIC_SITE_URL=https://entopharma.mn
